WAHA_API_KEY=change-me
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me
# WAHA_URL=http://localhost:3000

# Behaviour (all optional; invalid values stop the bot at startup with a clear message)
# BOT_NAME=rory                   # how people address the bot in a group: "rory weather in lahore"
# GROUP_MODE=mention              # mention = answer only when addressed | all = answer everything | off = ignore groups
# RATE_LIMIT_MAX=12               # messages per sender ...
# RATE_LIMIT_WINDOW=30            # ... per this many seconds
# DEDUP_TTL=300                   # seconds a message id is remembered (WAHA retries)
# CHAT_IDLE_TTL=3600              # forget a chat's state after this many idle seconds
# MAX_CHATS=10000                 # hard cap on remembered chats
# MAX_MESSAGE_CHARS=1000          # longer messages get a polite refusal
# WEBHOOK_HMAC_KEY=                # verify WAHA's signature. Put the SAME value in WHATSAPP_HOOK_HMAC_KEY below (WAHA reads this file too)
# WHATSAPP_HOOK_HMAC_KEY=          # WAHA signs every webhook with this key (header X-Webhook-Hmac); the bot also reads it if WEBHOOK_HMAC_KEY is unset
# WEBHOOK_TOKEN=                   # alternative: a shared token in an X-Webhook-Token header (WAHA: WHATSAPP_HOOK_CUSTOM_HEADERS=X-Webhook-Token:<token>)
# WAHA_CLIENT=fast                 # fast = small keep-alive client for http:// WAHA URLs; httpx = the general client (also used automatically for https)
# MAX_BODY_BYTES=100000           # webhook bodies above this are rejected with 413
# WORKERS=32                      # messages handled at once
# QUEUE_SIZE=10000                # waiting messages; when full the webhook answers 503 (WAHA retries)
# UNMATCHED_PATH=data/unmatched.jsonl   # improvement inbox: messages Rory could not handle (empty = off); review: scripts/unmatched.py
# UNMATCHED_RETENTION_DAYS=30
# LOG_JSON=true                   # one JSON object per log line (false = readable text for local development)
# LOG_LEVEL=INFO

# Optional
# BOT_CONTACT=you@example.com     # sent in the User-Agent (Wikipedia asks for contact info)
# TMDB_API_KEY=                   # movie ratings (otherwise movies come from Wikipedia)
# GITHUB_TOKEN=                   # higher GitHub API rate limits
# NEWS_COUNTRY=US                 # Google News edition (two letters, e.g. PK, GB, IN)
# GOOGLE_API_KEY=                 # web search (Google Programmable Search)
# GOOGLE_CSE_ID=
